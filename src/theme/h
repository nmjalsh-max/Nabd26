<style data-purpose="custom-fonts">
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
  </style>
<style data-purpose="custom-utilities">
    body {
      background-color: theme('colors.surface');
      color: theme('colors.on-surface');
      font-family: theme('fontFamily.sans');
      overflow-x: hidden;
    }
    
    /* Background Animation */
    .bg-mesh {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      background: radial-gradient(circle at 15% 50%, rgba(139, 92, 246, 0.08), transparent 25%),
                  radial-gradient(circle at 85% 30%, rgba(79, 70, 229, 0.08), transparent 25%);
      animation: pulse-mesh 15s ease-in-out infinite alternate;
    }
    
    @keyframes pulse-mesh {
      0% {
        transform: scale(1);
        opacity: 0.8;
      }
      100% {
        transform: scale(1.1);
        opacity: 1;
      }
    }

    /* Card Entrance Animation */
    .fade-in-up {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
      transform: translateY(20px);
    }
    
    @keyframes fadeInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .gradient-btn {
      background: linear-gradient(90deg, #8b5cf6 0%, #4f46e5 100%);
    }
    .gradient-btn:hover {
      background: linear-gradient(90deg, #a78bfa 0%, #6366f1 100%);
    }
    .input-field {
      background-color: theme('colors.surface-bright'); 
      color: theme('colors.on-surface');
      border: 1px solid theme('colors.outline-variant');
    }
    .input-field:focus {
      border-color: theme('colors.primary-brand');
      outline: none;
      box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
    }
    .input-field::placeholder {
      color: theme('colors.on-surface-variant');
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased relative">
<!-- Background Animation -->
<div class="bg-mesh"></div>
<!-- BEGIN: MainHeader -->
<header class="w-full py-6 px-8 flex justify-between items-center absolute top-0 left-0 z-10">
<!-- Logo and Branding -->
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-full bg-surface-bright flex items-center justify-center border border-primary-brand/30 text-primary-brand">
<svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M13 10V3L4 14h7v7l9-11h-7z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
</div>
<span class="font-semibold text-lg tracking-wide text-primary-brand">Nabd Space</span>
</div>
<!-- Language Toggle -->
<div class="flex items-center gap-4 text-sm font-medium">
<button class="px-4 py-2 rounded-full border border-primary-brand text-on-surface bg-surface-container-low transition-colors hover:bg-surface-bright">English</button>
<button class="px-4 py-2 rounded-full text-on-surface-variant hover:text-on-surface transition-colors">العربية</button>
</div>
</header>
<!-- END: MainHeader -->
<!-- BEGIN: MainContent -->
<main class="flex-grow flex items-center justify-center p-4 pt-24 sm:pt-32">
<!-- Login Card -->
<div class="w-full max-w-md bg-surface-container border border-surface-variant rounded-[20px] p-8 sm:p-10 shadow-2xl fade-in-up">
<div class="text-center mb-8">
<h1 class="text-2xl font-bold mb-2 text-on-surface">Sign in</h1>
<p class="text-on-surface-variant text-sm leading-relaxed">Unified interface — visual toggle between Employee / Admin.</p>
</div>
<!-- Role Toggle -->
<div class="flex bg-surface-bright rounded-custom p-1 mb-8 shadow-inner border border-outline-variant">
<button class="flex-1 py-2 text-sm font-medium rounded-custom gradient-btn text-white shadow-sm transition-all">Employee</button>
<button class="flex-1 py-2 text-sm font-medium rounded-custom text-on-surface-variant hover:text-on-surface transition-all">Admin</button>
</div>
<!-- Login Form -->
<form action="#" class="space-y-5" method="POST">
<!-- Email/ID Input -->
<div>
<label class="block text-sm font-medium text-on-surface-variant mb-2" for="identifier">Email or employee ID</label>
<input class="input-field block w-full rounded-custom py-3 px-4 sm:text-sm transition-all" id="identifier" name="identifier" placeholder="Enter email or ID" type="text" value="admin"/>
</div>
<!-- Password Input -->
<div>
<label class="block text-sm font-medium text-on-surface-variant mb-2" for="password">Password</label>
<input class="input-field block w-full rounded-custom py-3 px-4 sm:text-sm transition-all" id="password" name="password" placeholder="Enter password" type="password" value="••••"/>
</div>
<!-- Forgot Password Link -->
<div class="flex justify-end">
<a class="text-sm font-medium text-primary-brand-light hover:text-primary-brand transition-colors" href="#">Forgot password?</a>
</div>
<!-- Submit Button -->
<button class="w-full gradient-btn text-white font-semibold py-3 px-4 rounded-custom transition-all shadow-lg hover:shadow-primary-brand/20 flex justify-center items-center gap-2 mt-4" type="submit">
          Sign in <span aria-hidden="true">→</span>
</button>
</form>
<!-- Footer Info -->
<div class="mt-8 text-center border-t border-surface-variant pt-6">
<p class="text-xs text-on-surface-variant mb-2">Uses Supabase Auth to sign in, or demo data for local preview</p>
<p class="text-xs font-mono text-primary-brand-light/80 mb-6 tracking-wider">emp1 / 1234 — admin / 1234</p>
<p class="text-sm text-on-surface-variant">
          Don't have an account? 
          <a class="font-medium text-on-surface hover:text-primary-brand transition-colors border-b border-transparent hover:border-primary-brand pb-0.5" href="#">Create account</a>
</p>
</div>
</div>
</main>
<!-- END: MainContent -->
</body></html>
